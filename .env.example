# AI providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Recipient-owned Supabase project
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Recipient-owned Slack app
SLACK_SIGNING_SECRET=
