# Protects direct/cron calls to daily-digest. Generate with: openssl rand -hex 32
DIGEST_SECRET=

# Optional: enables Calendar and Gmail context in the digest
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Optional personalization
USER_TIMEZONE=America/Los_Angeles
OBSIDIAN_VAULT_PATH=
